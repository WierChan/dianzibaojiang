# 后端已内置在本项目(app/api/*),以下变量都可选。

# JWT 签名密钥。上线务必设一个随机长字符串,否则用默认值(不安全)。
AUTH_SECRET=change-me-to-a-long-random-string

# 后端 API 基址。留空 = 同源(用内置后端)。仅当你想改用外部后端时才设置。
# ⚠️ NEXT_PUBLIC_ 前缀会打进前端包、对用户可见,切勿放密钥。
# NEXT_PUBLIC_API_BASE_URL=

# 数据存放位置(可选,默认在项目根的 data/ 下)。
# PATINA_DB=./data/patina.db
# PATINA_UPLOADS=./data/uploads
